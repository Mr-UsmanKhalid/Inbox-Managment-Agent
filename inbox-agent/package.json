{
  "name": "inbox-agent",
  "version": "0.1.0",
  "description": "AI Inbox Management Agent - LangGraph + LangChain + OpenAI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:cli": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:mock": "cross-env MOCK_LLM=true tsx src/index.ts",
    "server": "node dist/server.js",
