    "dev:server:mock": "cross-env MOCK_LLM=true tsx src/server.ts"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.26",
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.18",
    "@langchain/groq": "^0.2.4",
    "@langchain/langgraph": "^0.2.20",
    "@langchain/openai": "^0.3.14",
    "@langchain/pinecone": "^0.2.0",
    "@pinecone-database/pinecone": "^5.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lowdb": "^7.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "cross-env": "^7.0.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
